{
  "meta": { "id": "demo", "version": "2.2.0", "schemaVersion": 2, "name": "Demo Pack" },
  "base": {
    "boards": [{ "id": "plaza", "name": "Plaza", "aspect": 1 }],
    "spaces": [
      { "id": "north", "name": "North", "position": { "board": "plaza", "x": 50, "y": 14 } },
      { "id": "east", "name": "East", "position": { "board": "plaza", "x": 86, "y": 50 } },
      {
        "id": "south",
        "name": "South",
        "tags": ["goal"],
        "position": { "board": "plaza", "x": 50, "y": 86 }
      },
      { "id": "west", "name": "West", "position": { "board": "plaza", "x": 14, "y": 50 } },
      { "id": "centre", "name": "Centre", "position": { "board": "plaza", "x": 50, "y": 50 } }
    ],
    "edges": [
      { "id": "north-east", "fromSpace": "north", "toSpace": "east" },
      { "id": "east-south", "fromSpace": "east", "toSpace": "south" },
      { "id": "south-west", "fromSpace": "south", "toSpace": "west" },
      { "id": "west-north", "fromSpace": "west", "toSpace": "north" },
      { "id": "centre-north", "fromSpace": "centre", "toSpace": "north" },
      { "id": "centre-south", "fromSpace": "centre", "toSpace": "south" }
    ],
    "edgeFilters": [{ "id": "walk" }],
    "unitKinds": [
      {
        "id": "walker",
        "name": "Walker",
        "attributes": [{ "id": "steps", "name": "Steps", "start": 0, "min": 0 }]
      }
    ],
    "counters": [
      { "id": "score", "name": "Score", "start": 0, "min": 0, "max": 10 },
      { "id": "rounds-left", "name": "Rounds left", "start": 6, "min": 0 },
      { "id": "plays", "name": "Plays this round", "start": 0, "min": 0, "resetScope": "round" }
    ],
    "zones": [
      { "id": "draw", "name": "Draw pile", "face": "down" },
      { "id": "hand", "name": "Hand" },
      { "id": "discard", "name": "Discard pile" }
    ],
    "cards": [
      {
        "id": "red-circle",
        "name": "Red Circle",
        "text": "Gain 1 score.",
        "copies": 2,
        "effects": [{ "type": "changeCounter", "counter": "score", "amount": 1 }]
      },
      {
        "id": "blue-square",
        "name": "Blue Square",
        "text": "Gain 1 score. Draw 1 card.",
        "copies": 2,
        "effects": [
          { "type": "changeCounter", "counter": "score", "amount": 1 },
          { "type": "moveCards", "from": "draw", "to": "hand", "count": 1 }
        ]
      },
      {
        "id": "green-triangle",
        "name": "Green Triangle",
        "text": "Gain 2 score.",
        "effects": [{ "type": "changeCounter", "counter": "score", "amount": 2 }]
      },
      {
        "id": "yellow-star",
        "name": "Yellow Star",
        "text": "Choose: gain 2 score, or gain 1 round.",
        "effects": [
          {
            "type": "choose",
            "options": [
              {
                "id": "gain",
                "label": "Gain 2",
                "effects": [{ "type": "changeCounter", "counter": "score", "amount": 2 }]
              },
              {
                "id": "extend",
                "label": "Gain a round",
                "effects": [{ "type": "changeCounter", "counter": "rounds-left", "amount": 1 }]
              }
            ]
          }
        ]
      },
      {
        "id": "orange-diamond",
        "name": "Orange Diamond",
        "text": "Play only after another card this round. Gain 3 score.",
        "playable": { "gte": [{ "counter": "plays" }, 1] },
        "effects": [{ "type": "changeCounter", "counter": "score", "amount": 3 }]
      }
    ],
    "triggers": [
      {
        "id": "count-steps",
        "on": { "event": "unitMoved", "kind": "walker" },
        "effects": [
          { "type": "changeAttribute", "unit": "self", "attribute": "steps", "amount": 1 }
        ]
      },
      {
        "id": "reach-goal",
        "on": { "event": "unitMoved", "kind": "walker", "toSpace": "south" },
        "effects": [{ "type": "changeCounter", "counter": "score", "amount": 1 }]
      },
      {
        "id": "count-plays",
        "on": { "event": "cardsMoved", "from": "hand", "to": "discard" },
        "effects": [{ "type": "changeCounter", "counter": "plays", "amount": 1 }]
      }
    ],
    "checks": [
      {
        "id": "refill-draw",
        "condition": {
          "and": [{ "eq": [{ "zoneCount": "draw" }, 0] }, { "gt": [{ "zoneCount": "discard" }, 0] }]
        },
        "effects": [
          {
            "type": "moveCards",
            "from": "discard",
            "to": "draw",
            "count": { "zoneCount": "discard" }
          },
          { "type": "shuffle", "zone": "draw" }
        ]
      }
    ],
    "endConditions": [
      {
        "id": "reached-goal",
        "condition": { "gte": [{ "counter": "score" }, 10] },
        "outcome": "win"
      },
      {
        "id": "out-of-rounds",
        "condition": { "lte": [{ "counter": "rounds-left" }, 0] },
        "outcome": "loss"
      }
    ],
    "setup": [
      { "type": "createCards", "card": "red-circle", "zone": "draw" },
      { "type": "createCards", "card": "blue-square", "zone": "draw" },
      { "type": "createCards", "card": "green-triangle", "zone": "draw" },
      { "type": "createCards", "card": "yellow-star", "zone": "draw" },
      { "type": "createCards", "card": "orange-diamond", "zone": "draw" },
      { "type": "shuffle", "zone": "draw" },
      {
        "type": "createUnit",
        "kind": "walker",
        "id": "runner",
        "placement": { "onSpace": { "space": "north" } }
      }
    ],
    "phases": [
      {
        "id": "draw",
        "steps": [
          {
            "id": "draw-cards",
            "effects": [{ "type": "moveCards", "from": "draw", "to": "hand", "count": 3 }]
          }
        ]
      },
      {
        "id": "move",
        "steps": [
          {
            "id": "walk",
            "effects": [
              { "type": "stepMove", "unit": { "id": "runner" }, "steps": 2, "filter": "walk" }
            ]
          }
        ]
      },
      {
        "id": "play",
        "steps": [
          {
            "id": "play-cards",
            "effects": [{ "type": "playWindow", "from": "hand", "to": "discard" }]
          }
        ]
      },
      {
        "id": "cleanup",
        "steps": [
          {
            "id": "discard-hand",
            "effects": [
              {
                "type": "moveCards",
                "from": "hand",
                "to": "discard",
                "count": { "zoneCount": "hand" }
              }
            ]
          },
          {
            "id": "tick",
            "effects": [{ "type": "changeCounter", "counter": "rounds-left", "amount": -1 }]
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "id": "bonus-cards",
      "kind": "extra-content",
      "precedence": 1,
      "content": {
        "cards": [
          {
            "id": "purple-hexagon",
            "name": "Purple Hexagon",
            "text": "Gain 2 score. Draw 1 card.",
            "effects": [
              { "type": "changeCounter", "counter": "score", "amount": 2 },
              { "type": "moveCards", "from": "draw", "to": "hand", "count": 1 }
            ]
          }
        ],
        "setup": [
          { "type": "createCards", "card": "purple-hexagon", "zone": "draw" },
          { "type": "shuffle", "zone": "draw" }
        ]
      }
    }
  ],
  "choices": [{ "id": "extras", "options": ["bonus-cards"], "min": 0, "max": 1 }]
}
